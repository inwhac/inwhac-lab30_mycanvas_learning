  // 학습중 + 수료 확정
  { id:5, name:'AI 활용 업무 생산성 높이기',          type:'micro',  progress:100, time:'15분',       period:'2025.10.01 ~ 2026.06.30', state:'ing',       completion:'pass' },
  { id:6, name:'협업 도구 활용법',                    type:'micro',  progress:100, time:'12분',       period:'2025.11.15 ~ 2026.05.15', state:'ing',       completion:'pass' },
  { id:7, name:'비즈니스 글쓰기 핵심 원칙',           type:'online', progress:100, time:'50분',       period:'2025.09.01 ~ 2026.06.01', state:'ing',       completion:'pass' },
  // 학습중 + 미수료 확정
  { id:8, name:'엑셀 고급 활용',                      type:'online', progress:45, time:'1시간 05분',  period:'2025.08.01 ~ 2026.03.31', state:'ing',       completion:null },
  // 예정
  { id:9,  name:'디지털 마케팅 전략',                 type:'online', progress:0,  time:'0분',         period:'2026.06.01 ~ 2026.08.31', state:'upcoming',  completion:null },
  { id:10, name:'조직 심리학 기초',                   type:'micro',  progress:0,  time:'0분',         period:'2026.07.01 ~ 2026.09.30', state:'upcoming',  completion:null },
  // 종료 (기간 종료)
  { id:11, name:'신입사원 온보딩 과정',               type:'online', progress:100, time:'3시간',      period:'2025.01.01 ~ 2025.03.31', state:'terminated', completion:'pass' },
  { id:12, name:'OKR 목표 설정 방법론',               type:'online', progress:55,  time:'1시간',      period:'2025.04.01 ~ 2025.06.30', state:'terminated', completion:'fail' },
];

/* ── 쇼츠 데이터 ── */
const SHORTS = [
  { id:1, name:'1분 만에 배우는 피드백 스킬',          progress:100, lastViewed:'2026.05.03' },
  { id:2, name:'회의를 짧게 끝내는 3가지 방법',        progress:75,  lastViewed:'2026.05.01' },
  { id:3, name:'업무 집중력 높이는 뽀모도로 기법',     progress:100, lastViewed:'2026.04.28' },
  { id:4, name:'팀장이 절대 하지 말아야 할 말 TOP3',   progress:40,  lastViewed:'2026.04.20' },
  { id:5, name:'30초 자기소개 완성 공식',              progress:100, lastViewed:'2026.04.15' },
  { id:6, name:'엑셀 단축키 10가지 총정리',            progress:60,  lastViewed:'2026.04.10' },
];

const SHORTS_COLORS = [
  ['#6c5ce7','#a29bfe'],['#e17055','#fdcb6e'],['#00b894','#00cec9'],
  ['#0984e3','#74b9ff'],['#d63031','#ff7675'],['#2d3436','#636e72'],
];

/* ── 쇼츠 렌더러 ── */
function renderShortsCard(s) {
  const [c1, c2] = SHORTS_COLORS[(s.id - 1) % SHORTS_COLORS.length];
  const fillClass = s.progress === 100 ? 'shorts-progress-fill done' : 'shorts-progress-fill';
  return `
  <div class="shorts-card">
    <div class="shorts-thumb">
      <div class="shorts-thumb-bg" style="background:linear-gradient(180deg,${c1},${c2});">
        🎬
      </div>
      <div class="shorts-play-icon">▶</div>
      <div class="shorts-progress-bar">
        <div class="${fillClass}" style="width:${s.progress}%"></div>
      </div>
    </div>
    <div class="shorts-body">
      <div class="shorts-name">${s.name}</div>
      <div class="shorts-date">최근 시청 ${s.lastViewed}</div>
    </div>
  </div>`;
}

function fillShortsGrid(el) {
  if (!el) return;
  el.innerHTML = SHORTS.map(s => renderShortsCard(s)).join('');
}

/* 썸네일 배경색 풀 */
const THUMB_COLORS = [
  ['#1a1a2e','#16213e'],['#0f3460','#1a1a2e'],['#e94560','#0f3460'],
  ['#2c3e50','#3498db'],['#1e3a5f','#2980b9'],['#16a085','#1abc9c'],
  ['#8e44ad','#9b59b6'],['#2d3436','#636e72'],['#c0392b','#e74c3c'],
  ['#27ae60','#2ecc71'],['#d35400','#e67e22'],['#2c3e50','#34495e'],
];

/* ────────────────────────────────────────
   카드 렌더러
──────────────────────────────────────── */
function renderCard(card, opts = {}) {
  const { dimmed = false } = opts;
  const [c1, c2] = THUMB_COLORS[(card.id - 1) % THUMB_COLORS.length];

  const typeBadge = card.type === 'micro'
    ? `<span class="card-type-badge micro">Micro</span>`
    : `<span class="card-type-badge">온라인</span>`;

  const completionBadge = card.completion === 'pass'
    ? `<span class="badge badge-success">수료</span>`
    : card.completion === 'fail'
    ? `<span class="badge badge-error">미수료</span>`
    : '';

  const progressFillClass = card.completion === 'pass' ? 'progress-fill done' : 'progress-fill';

  const cardClass = [
    'card',
    dimmed ? 'dimmed' : '',
    card.completion === 'pass' ? 'completed-style' : ''
  ].filter(Boolean).join(' ');

  return `
  <div class="${cardClass}">
    <div class="card-thumb">
      <div class="thumb-placeholder" style="background:linear-gradient(135deg,${c1},${c2});">
        <span style="font-size:10px;opacity:0.6">${card.name.slice(0,4)}</span>
      </div>
      ${typeBadge}
    </div>
    <div class="card-body">
      <div class="progress-bar"><div class="${progressFillClass}" style="width:${card.progress}%"></div></div>
      <div class="card-meta">
        <span>⏱ ${card.time} 학습</span>
        ${completionBadge}
      </div>
      <div class="card-name">${card.name}</div>
      <div class="card-period">${card.period}</div>
    </div>
  </div>`;
}

function fillGrid(el, cards, opts = {}) {
  if (!el) return;
  if (cards.length === 0) {
    el.innerHTML = `<div class="empty-state" style="grid-column:1/-1"><div class="empty-icon">📭</div>해당하는 학습이 없습니다.</div>`;
    return;
  }
  el.innerHTML = cards.map(c => renderCard(c, opts)).join('');
}

/* ────────────────────────────────────────
   VER.1 초기화
──────────────────────────────────────── */
let v1PeriodFilter = 'all';
let v1TermFilter = 'all';

function filterByPeriod(cards, year) {
  if (year === 'all') return cards;
  return cards.filter(c => c.period.includes(year));
}

function initV1() {
  const ingCards   = CARDS.filter(c => c.state === 'ing' && !c.completion);
  const doneCards  = CARDS.filter(c => c.state === 'ing' && c.completion === 'pass');
  const upcoming   = CARDS.filter(c => c.state === 'upcoming');

  fillGrid(document.getElementById('v1-active-cards'),    ingCards);
  fillGrid(document.getElementById('v1-completed-cards'), doneCards);
  fillGrid(document.getElementById('v1-upcoming-cards'),  upcoming);
  document.getElementById('v1-complete-count').textContent = doneCards.length;
  renderV1Terminated();
}

function renderV1Terminated() {
  const terminated  = CARDS.filter(c => c.state === 'terminated');
  const byPeriod    = filterByPeriod(terminated, v1PeriodFilter);
  const byPass      = byPeriod.filter(c => c.completion === 'pass');
  const byFail      = byPeriod.filter(c => c.completion !== 'pass');
  const filtered    = v1TermFilter === 'pass' ? byPass : v1TermFilter === 'fail' ? byFail : byPeriod;

  fillGrid(document.getElementById('v1-terminated-cards'), filtered, { dimmed: true });
  document.getElementById('v1-terminated-count').textContent = filtered.length;

  ['all','pass','fail'].forEach(k => {
    const el = document.getElementById(`v1-term-filter-${k}`);
    if (el) el.classList.toggle('active', k === v1TermFilter);
  });
}

function setV1PeriodFilter(val) { v1PeriodFilter = val; renderV1Terminated(); }
function setV1TermFilter(val)   { v1TermFilter = val;   renderV1Terminated(); }

let v1Hidden = false;
function toggleV1(el) {
  v1Hidden = !v1Hidden;
  const sw = document.getElementById('v1-toggle');
  sw.classList.toggle('on', v1Hidden);
  document.getElementById('v1-completed-section').style.display = v1Hidden ? 'none' : '';
}

/* ────────────────────────────────────────
   VER.2 초기화 & 필터
──────────────────────────────────────── */
let v2Filter = 'all';
let v2PeriodFilter = 'all';
function initV2() { renderV2(); }

function renderV2() {
  const remain = CARDS.filter(c =>
    c.state === 'upcoming' ||
    (c.state === 'ing' && (c.completion === null || c.completion === 'fail'))
  );
  const doneAll  = CARDS.filter(c =>
    (c.state === 'ing' && c.completion === 'pass') ||
    c.state === 'terminated'
  );
  const periodFiltered = filterByPeriod(doneAll, v2PeriodFilter);
  const donePass = periodFiltered.filter(c => c.completion === 'pass');
  const doneFail = periodFiltered.filter(c => c.completion !== 'pass');
  const doneToShow = v2Filter === 'pass' ? donePass : v2Filter === 'fail' ? doneFail : periodFiltered;

  document.getElementById('v2-remain-count').textContent = remain.length;
  document.getElementById('v2-done-count').textContent   = periodFiltered.length;

  fillGrid(document.getElementById('v2-remain-cards'), remain);
  fillGrid(document.getElementById('v2-done-cards'),   doneToShow);

  ['all','pass','fail'].forEach(k => {
    const el = document.getElementById(`v2-filter-${k}`);
    if (el) {
      el.classList.toggle('active', k === v2Filter);
    }
  });
}

function setV2Filter(f) { v2Filter = f; renderV2(); }
function setV2PeriodFilter(val) { v2PeriodFilter = val; renderV2(); }

/* ────────────────────────────────────────
   VER.3 초기화 & 필터
──────────────────────────────────────── */
let v3Filter = 'all';
let v3PeriodFilter = 'all';
function initV3() { renderV3(); }

function renderV3() {
  const ing = CARDS.filter(c => c.state === 'ing' && (c.completion === null || c.completion === 'fail') && !isTerminated(c));
  const terminatedAll = CARDS.filter(c =>
    c.state === 'terminated' ||
    (c.state === 'ing' && c.completion === 'pass')
  );
  const periodFiltered = filterByPeriod(terminatedAll, v3PeriodFilter);
  const termPass = periodFiltered.filter(c => c.completion === 'pass');
  const termFail = periodFiltered.filter(c => c.completion !== 'pass');
  const termShow = v3Filter === 'pass' ? termPass : v3Filter === 'fail' ? termFail : periodFiltered;

  const upcoming = CARDS.filter(c => c.state === 'upcoming');

  document.getElementById('v3-ing-count').textContent   = ing.length;
  document.getElementById('v3-done-count').textContent  = periodFiltered.length;

  fillGrid(document.getElementById('v3-ing-cards'),      ing);
  fillGrid(document.getElementById('v3-upcoming-cards'), upcoming);
  fillGrid(document.getElementById('v3-done-cards'),     termShow, { dimmed: true });

  ['all','pass','fail'].forEach(k => {
    const el = document.getElementById(`v3-filter-${k}`);
    if (el) el.classList.toggle('active', k === v3Filter);
  });
}

function isTerminated(c) { return c.state === 'terminated'; }
function setV3Filter(f) { v3Filter = f; renderV3(); }
function setV3PeriodFilter(val) { v3PeriodFilter = val; renderV3(); }

/* ────────────────────────────────────────
   VER.4 초기화 & 필터
──────────────────────────────────────── */
let v4Filter = 'all';
let v4TermFilter = 'all';
let v4PeriodFilter = 'all';
function initV4() { renderV4(); }

function renderV4() {
  const ingAll  = CARDS.filter(c => c.state === 'ing');
  const ingPass = ingAll.filter(c => c.completion === 'pass');
  const ingFail = ingAll.filter(c => c.completion !== 'pass');
  const ingShow = v4Filter === 'pass' ? ingPass : v4Filter === 'fail' ? ingFail : ingAll;

  const upcoming   = CARDS.filter(c => c.state === 'upcoming');
  const terminated = CARDS.filter(c => c.state === 'terminated');
  const termPeriod = filterByPeriod(terminated, v4PeriodFilter);
  const termPass   = termPeriod.filter(c => c.completion === 'pass');
  const termFail   = termPeriod.filter(c => c.completion !== 'pass');
  const termShow   = v4TermFilter === 'pass' ? termPass : v4TermFilter === 'fail' ? termFail : termPeriod;

  document.getElementById('v4-ing-count').textContent        = ingShow.length;
  document.getElementById('v4-terminated-count').textContent = termShow.length;

  fillGrid(document.getElementById('v4-ing-cards'),        ingShow);
  fillGrid(document.getElementById('v4-upcoming-cards'),   upcoming);
  fillGrid(document.getElementById('v4-terminated-cards'), termShow, { dimmed: true });

  // 학습중 필터 버튼 스타일
  ['all','pass','fail'].forEach(k => {
    const el = document.getElementById(`v4-filter-${k}`);
    if (el) el.classList.toggle('active', k === v4Filter);
  });

  // 종료 필터 버튼 스타일
  ['all','pass','fail'].forEach(k => {
    const el = document.getElementById(`v4-term-filter-${k}`);
    if (el) el.classList.toggle('active', k === v4TermFilter);
  });
}

function setV4Filter(f) { v4Filter = f; renderV4(); }
function setV4TermFilter(f) { v4TermFilter = f; renderV4(); }
function setV4PeriodFilter(val) { v4PeriodFilter = val; renderV4(); }

/* ────────────────────────────────────────
   학습 필터링 공통 로직
──────────────────────────────────────── */
const filterState = {
  v1: { completion: 'all', offline: false, book: false },
  v2: { completion: 'all', offline: false, book: false },
  v3: { completion: 'all', offline: false, book: false },
  v4: { completion: 'all', offline: false, book: false },
};

function setFC(vid, val) {
  filterState[vid].completion = val;
  ['all','pass','fail'].forEach(k => {
    const el = document.getElementById(`${vid}fc-${k}`);
    if (el) el.classList.toggle('active', k === val);
  });
  applyIngFilter(vid);
}
function setV1FC(v) { setFC('v1', v); }
function setV2FC(v) { setFC('v2', v); }
function setV3FC(v) { setFC('v3', v); }
function setV4FC(v) { setFC('v4', v); }

function toggleOpt(el, vid, key) {
  const cur = filterState[vid][key];
  filterState[vid][key] = !cur;
  el.classList.toggle('on', !cur);
  applyIngFilter(vid);
}

function applyIngFilter(vid) {
  const s = filterState[vid];
  // 각 버전별 대상 카드 풀 (학습중/남은학습)
  let pool;
  if (vid === 'v2') {
    pool = CARDS.filter(c =>
      c.state === 'upcoming' ||
      (c.state === 'ing' && (c.completion === null || c.completion === 'fail'))
    );
  } else if (vid === 'v3') {
    pool = CARDS.filter(c => c.state === 'ing' && (c.completion === null || c.completion === 'fail'));
  } else {
    // v1, v4: ing 전체
    pool = CARDS.filter(c => c.state === 'ing');
  }

  // 수료 여부 필터
  if (s.completion === 'pass') pool = pool.filter(c => c.completion === 'pass');
  else if (s.completion === 'fail') pool = pool.filter(c => c.completion !== 'pass');

  // 오프라인 토글: offline 속성 있는 것만 (데모용 - id 홀수 카드를 오프라인으로 간주)
  if (s.offline) pool = pool.filter(c => c.id % 2 === 1);
  // 교재 제공 토글: id % 3 === 0 카드를 교재 제공으로 간주
  if (s.book) pool = pool.filter(c => c.id % 3 === 0);

  // 각 버전 그리드에 반영
  if (vid === 'v1') {
    const active  = pool.filter(c => c.completion !== 'pass');
    const passed  = pool.filter(c => c.completion === 'pass');
    fillGrid(document.getElementById('v1-active-cards'),    active);
    fillGrid(document.getElementById('v1-completed-cards'), passed);
    document.getElementById('v1-complete-count').textContent = passed.length;
  } else if (vid === 'v2') {
    fillGrid(document.getElementById('v2-remain-cards'), pool);
    document.getElementById('v2-remain-count').textContent = pool.length;
  } else if (vid === 'v3') {
    fillGrid(document.getElementById('v3-ing-cards'), pool);
    document.getElementById('v3-ing-count').textContent = pool.length;
  } else if (vid === 'v4') {
    fillGrid(document.getElementById('v4-ing-cards'), pool);
    document.getElementById('v4-ing-count').textContent = pool.length;
  }
}

/* ────────────────────────────────────────
   버전 탭 전환
──────────────────────────────────────── */
function switchVersion(id, tabEl) {
  document.querySelectorAll('.version-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.version-tab').forEach(t => t.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  tabEl.classList.add('active');
}

/* 초기화 */
initV1();
initV2();
initV3();
initV4();
fillShortsGrid(document.getElementById('v1-shorts-cards'));
fillShortsGrid(document.getElementById('v2-shorts-cards'));
fillShortsGrid(document.getElementById('v3-shorts-cards'));
fillShortsGrid(document.getElementById('v4-shorts-cards'));
</script>
