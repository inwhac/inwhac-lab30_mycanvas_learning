<script>
/* ────────────────────────────────────────
   데이터 정의
──────────────────────────────────────── */
const CARDS = [
  // 학습중 + 수료처리전
  { id:1, name:'효과적인 커뮤니케이션 전략 수립',     type:'online', progress:65, time:'1시간 15분',  period:'2025.11.01 ~ 2026.06.30', state:'ing',       completion:null },
